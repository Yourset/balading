    map $ssl_preread_server_name $backend {
        dsh.example.com     127.0.0.1:8443;
        www.example.com     127.0.0.1:8444;
        example.com         127.0.0.1:8444;
        m.example.com       127.0.0.1:8445;
        default                  127.0.0.1:7000;
    }
    server {
        listen 443;
        proxy_pass $backend;
        ssl_preread on;
        proxy_timeout 30s;
        proxy_connect_timeout 10s;
    }
